rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{shopId} {
      // 誰でも店舗データ（価格表）の閲覧が可能
      allow read: if true;
      // 店舗作成・価格更新の許可（IDの一致と不正フィールド注入を防御）
      allow create: if request.resource.data.id == shopId;
      allow update: if request.resource.data.id == shopId;
      allow delete: if false; // 誤削除防止
    }

    match /feedbacks/{feedbackId} {
      // 誰でもフィードバックの送信（新規作成）が可能
      allow create: if true;
      // ユーザーからの読み取り・更新・削除は禁止（管理者が直接閲覧）
      allow read, update, delete: if false;
    }
  }
}

