rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{shopId} {
      // 誰でも店舗データ（価格表）の閲覧が可能
      allow read: if true;

      // 店舗新規作成の許可（IDの一致、名前・IDのバリデーション、パスコード露出防止）
      allow create: if request.resource.data.id == shopId
        && request.resource.data.id is string
        && request.resource.data.id.size() >= 2
        && request.resource.data.id.size() <= 30
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50
        && !('passcodeHash' in request.resource.data)
        && !('passcode' in request.resource.data)
        && (
          !('ownerUid' in request.resource.data)
          || request.resource.data.ownerUid == null
          || (request.auth != null && request.resource.data.ownerUid == request.auth.uid)
        );

      // 価格・設定更新の許可（オーナー認証、またはオーナー未登録店舗への引き継ぎ、またはsample店舗）
      allow update: if request.resource.data.id == shopId
        && !('passcodeHash' in request.resource.data)
        && !('passcode' in request.resource.data)
        && (
          shopId == 'sample'
          // オーナー本人による更新（ownerUid の不変性を強制）
          || (
            request.auth != null
            && resource.data.ownerUid != null
            && request.auth.uid == resource.data.ownerUid
            && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == resource.data.ownerUid)
          )
          // オーナー未登録店舗への初回オーナー紐付け（claim）
          || (
            request.auth != null
            && (!('ownerUid' in resource.data) || resource.data.ownerUid == null)
            && request.resource.data.ownerUid == request.auth.uid
          )
        );

      allow delete: if false; // 誤削除防止

      // パスコード認証情報の非公開ドキュメント
      match /auth/secret {
        // オーナー本人のみ読み取り可能
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/shops/$(shopId))
          && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;

        // 店舗新規作成時の同時バッチ作成を許可（先行作成攻撃防止）
        allow create: if request.resource.data.passcodeHash is string
          && request.resource.data.passcodeHash.size() == 64
          && existsAfter(/databases/$(database)/documents/shops/$(shopId));

        // オーナー本人によるパスコード再設定・変更を許可
        allow update: if request.auth != null
          && exists(/databases/$(database)/documents/shops/$(shopId))
          && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid
          && request.resource.data.passcodeHash is string
          && request.resource.data.passcodeHash.size() == 64;

        allow delete: if false;
      }

      // パスコード検証用ドキュメント（書き込みテストによる認証判定）
      match /auth/verify {
        // パスコードが一致する場合のみ書き込み成功
        allow write: if (
          shopId == 'sample'
          || (
            exists(/databases/$(database)/documents/shops/$(shopId)/auth/secret)
            && request.resource.data.passcodeHash == get(/databases/$(database)/documents/shops/$(shopId)/auth/secret).data.passcodeHash
          )
          || (
            !exists(/databases/$(database)/documents/shops/$(shopId)/auth/secret)
            && exists(/databases/$(database)/documents/shops/$(shopId))
            && (
              (get(/databases/$(database)/documents/shops/$(shopId)).data.passcodeHash != null
               && request.resource.data.passcodeHash == get(/databases/$(database)/documents/shops/$(shopId)).data.passcodeHash)
              || (get(/databases/$(database)/documents/shops/$(shopId)).data.passcode != null
               && request.resource.data.passcode == get(/databases/$(database)/documents/shops/$(shopId)).data.passcode)
            )
          )
        );

        // 外部からの読み取りは禁止
        allow read: if false;
      }
    }

    match /feedbacks/{feedbackId} {
      // フィードバックの送信（新規作成・バリデーションあり）
      allow create: if request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.type in ['bug', 'feature', 'other'];
      // ユーザーからの読み取り・更新・削除は禁止（管理者が直接閲覧）
      allow read, update, delete: if false;
    }
  }
}

